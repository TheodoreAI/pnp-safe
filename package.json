{
  "name": "pnp-safe",
  "version": "0.1.1",
  "description": "Information-theoretic cryptography for TypeScript: primitives whose security does not depend on P != NP.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/pnp-safe.test.js",
    "lab": "tsc -p . && node dist/examples/attack-lab/run.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cryptography",
    "one-time-pad",
    "shamir",
    "wegman-carter",
    "information-theoretic",
    "p-vs-np"
  ],
  "author": "TheodoreAI (https://github.com/TheodoreAI)",
  "license": "LicenseRef-pnp-safe-Commercial-1.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheodoreAI/pnp-safe.git"
  },
  "homepage": "https://github.com/TheodoreAI/pnp-safe#readme",
  "bugs": {
    "url": "https://github.com/TheodoreAI/pnp-safe/issues"
  }
}
